def _field_python_type(model_type: type, field_name: str) -> type:
    """Map a Django field (looked up by name on ``model_type``) to a Python type.

    Used to model ``queryset.values_list(field, flat=True)`` correctly: real
    Django yields field values, but the default MockQuerySet would yield model
    instances. Falls back to ``object`` if the field can't be resolved.
    """
    try:
        from django.db import models as _m
    except ImportError:
        return object
    try:
        field = model_type._meta.get_field(field_name)
    except Exception:
        return object
    if isinstance(field, _m.BooleanField):
        return bool
    if isinstance(field, _m.IntegerField):  # covers Small/Big/Positive variants
        return int
    if isinstance(field, _m.FloatField):
        return float
    if isinstance(field, _m.DateTimeField):
        from datetime import datetime
        return datetime
    if isinstance(field, _m.DateField):
        from datetime import date
        return date
    if isinstance(field, _m.TimeField):
        from datetime import time
        return time
    if isinstance(field, _m.DurationField):
        from datetime import timedelta
        return timedelta
    if isinstance(field, _m.UUIDField):
        from uuid import UUID
        return UUID
    if isinstance(field, _m.DecimalField):
        from decimal import Decimal
        return Decimal
    if isinstance(field, _m.BinaryField):
        return bytes
    if isinstance(field, _m.JSONField):
        return object
    if isinstance(field, _m.ForeignKey):
        # values_list('user') yields the FK id (an int).
        return int
    if isinstance(field, (_m.CharField, _m.TextField)):
        return str
    return object


