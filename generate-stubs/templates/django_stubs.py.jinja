def _patch_reverse_relations(model_class: type) -> None:
    """Replace Django reverse-relation and forward-M2M descriptors with stubs.

    For each reverse relation and forward M2M on ``model_class``:
      - ManyToOneRel / ManyToManyRel / forward M2M  → property returning MockManager(related)
      - OneToOneRel  → property returning a symbolic instance via proxy_for_type

    Without this, attribute access like ``project.check_set`` falls through to
    Django's real descriptor which queries the database.
    """
    try:
        meta = model_class._meta
    except AttributeError:
        return

    for rel in list(meta.related_objects):
        accessor = rel.get_accessor_name()
        if not accessor:
            continue  # related_name='+' disables reverse access
        related_model = rel.related_model
        cls_name = rel.__class__.__name__
        if cls_name == 'OneToOneRel':
            # ``user.profile`` returns a single Profile instance.
            setattr(
                model_class,
                accessor,
                property(lambda self, rm=related_model: proxy_for_type(
                    rm, f'reverse_one_to_one_{rm.__name__}',
                )),
            )
        else:
            # ManyToOneRel / ManyToManyRel — manager-style access.
            setattr(
                model_class,
                accessor,
                property(lambda self, rm=related_model: MockManager(rm)),
            )

    for field in list(meta.many_to_many):
        related_model = field.related_model
        setattr(
            model_class,
            field.name,
            property(lambda self, rm=related_model: MockManager(rm)),
        )


