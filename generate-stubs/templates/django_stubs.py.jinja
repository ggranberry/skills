            from django.contrib.auth.models import Permission as _DjangoPermission
            _DjangoPermission.objects = MockManager(_DjangoPermission)
            _DjangoPermission.save = mock_save
            _DjangoPermission.delete = mock_delete
            _DjangoPermission.refresh_from_db = mock_refresh_from_db
        except ImportError:
            pass
        try:
            from django.contrib.auth.models import Group as _DjangoGroup
            _DjangoGroup.objects = MockManager(_DjangoGroup)
            _DjangoGroup.save = mock_save
            _DjangoGroup.delete = mock_delete
            _DjangoGroup.refresh_from_db = mock_refresh_from_db
        except ImportError:
            pass

        # ---- Django staticfiles storage classes (Pattern 5g) ----
        # StaticFilesStorage / ManifestStaticFilesStorage have a
        # keyword-only-before-variadic-positional ``__init__`` MRO that crashes
        # ``inspect.Signature`` (``ValueError: wrong parameter order``) during
        # ``intersect_signatures`` in ``proxy_for_class``. Any code that
        # contracts a method on a ``ManifestStaticFilesStorage`` subclass
        # hits this. Register a ``__new__`` bypass factory so ``proxy_for_type``
        # short-circuits before ``proxy_for_class`` introspects the signature.
        try:
            from crosshair import register_type as _register_type
            from django.contrib.staticfiles.storage import (
                StaticFilesStorage as _StaticFilesStorage,
                ManifestStaticFilesStorage as _ManifestStaticFilesStorage,
            )

            def _make_storage_via_new(_cls):
                def _factory(_f, _c=_cls):
                    inst = _c.__new__(_c)
                    inst.__dict__.setdefault('hashed_files', {})
                    inst.__dict__.setdefault('manifest_strict', False)
                    inst.__dict__.setdefault('manifest_version', '1.1')
                    inst.__dict__.setdefault('base_url', '/')
                    inst.__dict__.setdefault('location', '')
                    return inst
                return _factory

            for _storage_cls in (_StaticFilesStorage, _ManifestStaticFilesStorage):
                try:
                    _register_type(_storage_cls, _make_storage_via_new(_storage_cls))
                except Exception:
                    pass  # Duplicate or unsupported
        except Exception:
            pass

        print("CrossHair Django ORM stubs installed ({{ tables|length }} models)")

    except ImportError as e:
