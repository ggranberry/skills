{% for table_name, table in tables.items() %}
        _patch_reverse_relations({{ table.model_class }})
{% endfor %}

        # ---- Django built-in models commonly hit by application code ----
        # auth.Permission/Group: any permission-check helper (e.g.
        # ``Permission.objects.get(codename=...)``) falls through to a real
        # ``sqlite3.connect`` without these, tripping CrossHair's auditwall
