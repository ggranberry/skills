# `exec(Path(plugin).read_text())` inside `crosshair.main.unwalled_main`.
# Class and function definitions therefore land in that function's *locals*,
# not module globals. When `install_stubs()` (or any other function defined
# above) is invoked, name lookups go through the function's own globals
# (crosshair.main) — sibling definitions are invisible there, producing a
# silent `NameError: name 'MockManager' is not defined` that the
# try/except in install_stubs swallows. Copy every local definition into
# globals before calling install_stubs so the call resolves correctly.
_local_names = dict(locals())
globals().update({k: v for k, v in _local_names.items() if not k.startswith('__')})

