"""
CrossHair plugin: Django setup for symbolic execution.

Three layers:

1. **Registry stubs** — patch ``django.apps.apps`` so model classes can be
   imported without ``django.setup()`` (no app loading, no DB).

2. **Symbolic-instance patches** — replace ``Model.__init__``, ``UUID.__init__``,
   ``forms.Field.__init__``, and ``BaseForm.__init__`` so user code that
   directly instantiates these classes (or accepts them as parameters)
   gets *constrained symbolic* values rather than concrete defaults.
   Without this, contracts like ``pre: "|" in self.channel.value`` would
   be unsatisfiable and every path returns UNKNOWN.

3. **Forward-reference resolution** — wrap ``typing.get_type_hints`` so
   recursive type aliases declared in ``{{ typealias_module }}``
   (typically ``JSONValue``/``JSONDict``-style) resolve from any
   importing module's namespace, not just the alias module's own.

Implementation notes:

- CrossHair ``exec()``s this file inside ``main()`` without a custom
  namespace. *Class bodies* AND *function bodies* defined in that exec
  context cannot reliably see exec-local names (Python 3 scoping
  limitation — class-body name resolution is documented; function-body
  closures over exec-locals also fail at call time, observed in practice).
  Mitigation: stub classes live in ``_crosshair_registry_patch.py``
  (a real importable module); patched ``__init__`` functions re-import
  what they need inside the function body; closures bind via default
  args.
- Set ``CH_DJANGO_DEBUG=1`` to print plugin diagnostics to stderr.
"""
import os

os.environ.setdefault("DJANGO_SETTINGS_MODULE", "{{ django_settings_module }}")

# ---------------------------------------------------------------------------
# Layer 1: Registry stubs (allows model files to import without django.setup())
# ---------------------------------------------------------------------------

# Import stubs from a real module — must happen before any Django imports
# so that get_containing_app_config and get_app_config can be patched first.
from _crosshair_registry_patch import _RegistryStubAppConfig

from django.apps import apps as _apps


def _patched_get_containing_app_config(self, object_name,
                                       _Stub=_RegistryStubAppConfig):
    """Return stub AppConfig for any module not registered in app_configs."""
    self.check_apps_ready()
    for app_config in self.app_configs.values():
        if object_name.startswith(app_config.name):
            subpath = object_name.removeprefix(app_config.name)
            if subpath == "" or subpath[0] == ".":
                return app_config
    parts = object_name.split(".")
    label = parts[-2] if len(parts) >= 2 else parts[0]
    name = ".".join(parts[:-1]) if len(parts) >= 2 else parts[0]
    return _Stub(label, name)


def _patched_get_app_config(self, app_label, _Stub=_RegistryStubAppConfig):
    """Return stub AppConfig instead of raising LookupError for unknown labels."""
    self.check_apps_ready()
    try:
        return self.app_configs[app_label]
    except KeyError:
        return _Stub(app_label)


_apps.__class__.get_containing_app_config = _patched_get_containing_app_config
_apps.__class__.get_app_config = _patched_get_app_config
_apps.apps_ready = True
_apps.models_ready = True
_apps.ready = True


# ---------------------------------------------------------------------------
# Layer 2a: Symbolic Model.__init__
# ---------------------------------------------------------------------------
#
# Django's Model.__init__ ends each kwarg pass with
#   ``setattr(self, field.attname, val)``,
# which routes through related-field descriptors. Those descriptors do
# ``cached != value`` on the symbolic int passed by CrossHair, but that
# comparison runs outside CrossHair's tracing region and trips:
#   ``CrossHairInternal: Numeric operation on symbolic while not tracing``.
#
# Replacement: write field values straight into ``self.__dict__``,
# skipping the descriptor chain. Values are *symbolic* when CrossHair is
# tracing (so contracts on ``self.<field>`` actually exercise paths) and
# concrete-empty otherwise (so the patch is safe for any imports the
# plugin triggers). ForeignKey targets are populated into
# ``_state.fields_cache`` so the forward descriptor returns them directly
# without a DB query.
from django.db.models.base import Model as _Model

# Map Django Field internal types to a Python type CrossHair can proxy.
# Only fields that map here get symbolic values; relations / generated /
# JSON / file-blob fields fall through to a sane concrete default.
import datetime as _dt
import decimal as _dec
import uuid as _uuid_mod

_DJANGO_FIELD_TO_PY: dict = {
    "CharField": str, "TextField": str, "SlugField": str,
    "EmailField": str, "URLField": str,
    "GenericIPAddressField": str, "IPAddressField": str,
    "FilePathField": str,
    "IntegerField": int, "BigIntegerField": int, "SmallIntegerField": int,
    "PositiveIntegerField": int, "PositiveSmallIntegerField": int,
    "PositiveBigIntegerField": int,
    "AutoField": int, "BigAutoField": int, "SmallAutoField": int,
    "BooleanField": bool, "NullBooleanField": bool,
    "FloatField": float,
    "BinaryField": bytes,
    # Date/time, UUID, and Decimal — without these, symbolic access to e.g.
    # ``flip.created`` returns None and any ``.replace(...)`` / ``.isoformat()``
    # call raises AttributeError. That's a stub gap, not a real bug — Django
    # enforces NOT NULL on these fields at the DB level.
    "DateTimeField": _dt.datetime,
    "DateField": _dt.date,
    "TimeField": _dt.time,
    "DurationField": _dt.timedelta,
    "UUIDField": _uuid_mod.UUID,
    "DecimalField": _dec.Decimal,
}

# Thread-local recursion guard so FK descriptor proxies don't blow the
# stack on cyclic schemas (Profile → Project → User → Profile → ...).
import threading as _threading
_init_state = _threading.local()


def _patched_model_init(self, *args, **kwargs):
    # Re-import inside the function body — the plugin's exec scope tears
    # down after CrossHair finishes loading it, so module-level closures
    # over exec-locals don't survive.
    from django.db.models.base import ModelState
    self.__dict__["_state"] = ModelState()
    opts = self._meta
    fields = list(opts.concrete_fields)

    # Try to upgrade default values to symbolic ones when CrossHair is
    # actively tracing. CrossHair's context_statespace() raises
    # CrossHairInternal (a BaseException, not Exception!) when there's
    # no statespace — catch BaseException so non-tracing imports
    # (django.setup-time class init, etc.) fall through cleanly.
    space = None
    proxy_for_type = None
    try:
        from crosshair.statespace import context_statespace
        from crosshair.core_and_libs import proxy_for_type as _pft
        space = context_statespace()
        proxy_for_type = _pft
    except BaseException:  # noqa: BLE001
        pass

    cls_name = type(self).__name__
    depth = getattr(_init_state, "depth", 0)
    _init_state.depth = depth + 1

    try:
        def _initial_value_for(f):
            # 1. If the field has an explicit default, honour it.
            if f.has_default():
                d = f.default
                return d() if callable(d) else d
            # 2. Try a symbolic value if we're inside CrossHair tracing
            #    AND the field maps to a known Python type. Wrap in Optional
            #    when the column allows NULL, so CrossHair explores both the
            #    present and absent paths — that's where most None-handling
            #    bugs live.
            if space is not None and proxy_for_type is not None:
                field_cls_name = type(f).__name__
                py_type = _DJANGO_FIELD_TO_PY.get(field_cls_name)
                if py_type is not None:
                    if getattr(f, "null", False):
                        from typing import Optional as _Opt
                        py_type = _Opt[py_type]
                    varname = f"{cls_name}_{f.attname}"
                    try:
                        result = proxy_for_type(py_type, varname)
                    except BaseException:  # noqa: BLE001
                        pass
                    else:
                        # Constrain DateTimeField proxies to be tz-aware when
                        # the project uses USE_TZ=True (Django's modern default).
                        # Production datetimes are always aware; without this,
                        # CrossHair generates naive datetimes and comparisons
                        # with aware constants raise TypeError — findings that
                        # can't occur in production. We pin tzinfo to a concrete
                        # UTC so year/month/day/etc remain symbolic while
                        # comparisons against aware constants are well-typed.
                        if result is not None and field_cls_name == "DateTimeField":
                            try:
                                from django.conf import settings as _s
                                if getattr(_s, "USE_TZ", True):
                                    import datetime as _dt
                                    result = result.replace(tzinfo=_dt.timezone.utc)
                            except BaseException:  # noqa: BLE001
                                pass
                        return result
            # 3. Mirror Django's runtime behavior for unset fields:
            #    "" for empty-strings-allowed CharField/TextField/etc.
            #    that aren't nullable; None otherwise.
            if getattr(f, "empty_strings_allowed", False) and not f.null:
                return ""
            return None

        for f in fields:
            self.__dict__[f.attname] = _initial_value_for(f)
        for val, field in zip(args, fields):
            self.__dict__[field.attname] = val
        for name, val in kwargs.items():
            self.__dict__[name] = val

        # Populate the related-instance cache for ForeignKey fields. The
        # forward descriptor reads ``_state.fields_cache[field.cache_name]``
        # before falling through to a DB query — putting a constructed
        # related instance there short-circuits the DB path entirely.
        # Populate at depth ≤ 1 so two-hop accesses like ``check.project.owner``
        # work, but deeper nesting falls back to an unpatched default-instance
        # to avoid stack-blowing on cyclic schemas. Depth 2+ is rare in
        # practice — most contracted code navigates at most two FKs deep.
        if depth <= 1:
            for f in opts.fields:
                if not (getattr(f, "is_relation", False)
                        and getattr(f, "many_to_one", False)):
                    continue
                related_model = getattr(f, "related_model", None)
                if related_model is None or related_model == "self":
                    continue
                cache_name = getattr(f, "cache_name", f.name)
                try:
                    self._state.fields_cache[cache_name] = related_model()
                except BaseException:  # noqa: BLE001
                    pass

        # Apply registered constraints (max_length, choices, etc.) once
        # symbolic values are in place. _apply_constraints comes from
        # _crosshair_stubs (the manager-side proxies generated by
        # /generate-stubs); skip silently if it's not installed.
        if space is not None:
            try:
                from _crosshair_stubs import _apply_constraints
                _apply_constraints(self, type(self))
            except BaseException:  # noqa: BLE001
                pass
    finally:
        _init_state.depth = depth


_Model.__init__ = _patched_model_init


# ---------------------------------------------------------------------------
# Layer 2b: UUID.__init__ bypass
# ---------------------------------------------------------------------------
#
# uuid.UUID.__init__ does ``if int >> 128: raise ValueError(...)`` on the
# symbolic int CrossHair passes, tripping the same "Numeric operation on
# symbolic while not tracing" wall.
#
# Two related issues:
# 1. UUID uses ``__slots__`` (not __dict__) on Python 3.12+, so the obvious
#    ``self.__dict__["int"] = int`` fails with AttributeError. Use
#    object.__setattr__ on the slot members instead — Python's own uuid.py
#    does the same.
# 2. UUID.__getstate__ does ``if self.is_safe != SafeUUID.unknown:`` — a
#    symbolic-vs-enum comparison that re-trips the wall during CrossHair's
#    argument deepcopy. UUIDs are immutable, so __deepcopy__ can return self.
import uuid as _uuid


def _patched_uuid_init(
    self, hex=None, bytes=None, bytes_le=None, fields=None, int=None,
    version=None, *, is_safe=_uuid.SafeUUID.unknown,
):
    if int is None:
        int = 0
    object.__setattr__(self, "int", int)
    object.__setattr__(self, "is_safe", is_safe)


def _patched_uuid_deepcopy(self, memo):
    return self


_uuid.UUID.__init__ = _patched_uuid_init
_uuid.UUID.__deepcopy__ = _patched_uuid_deepcopy


# ---------------------------------------------------------------------------
# Layer 2c: forms.Field.__init__ minimal init
# ---------------------------------------------------------------------------
#
# Real Field.__init__ iterates over ``error_messages`` and copies the
# widget; both crash on symbolic params. Replace with a minimal init
# that sets every attribute subclass __init__'s read (validators,
# error_messages, widget, etc.) without iterating any kwargs.
from django.forms.fields import Field as _FormField


def _patched_field_init(self, *args, **kwargs):
    self.required = True
    self.label = None
    self.initial = None
    self.help_text = ""
    self.disabled = False
    self.label_suffix = None
    self.bound_field_class = getattr(self, "bound_field_class", None)
    self.localize = False
    self.show_hidden_initial = False
    self.template_name = None
    # Walk the MRO to collect default_error_messages, mirroring the real
    # Field.__init__. Without this, subclasses that raise
    # ValidationError(code='required') KeyError on the message lookup.
    messages = {}
    for c in reversed(type(self).__mro__):
        messages.update(getattr(c, "default_error_messages", {}))
    self.error_messages = messages
    self.validators = list(getattr(type(self), "default_validators", ()))
    # Some subclass __init__'s (ChoiceField, etc.) do
    # ``self.widget.choices = ...`` — give widget a real namespace.
    import types as _types
    self.widget = _types.SimpleNamespace(
        attrs={}, is_required=False, is_localized=False, choices=[]
    )


_FormField.__init__ = _patched_field_init


# ---------------------------------------------------------------------------
# Layer 2d: BaseForm.__init__ + cleaned_data proxy
# ---------------------------------------------------------------------------
#
# clean_X(self) methods read ``self.cleaned_data["X"]``. In production
# that dict is populated by ``_clean_fields()`` before clean_X runs;
# under symbolic exec we have to pre-fill it with one symbolic value
# per declared field, matching the field's type.
from django.forms.forms import BaseForm as _BaseForm

_FORM_FIELD_TO_PY: dict = {
    "CharField": str, "EmailField": str, "URLField": str,
    "SlugField": str, "RegexField": str, "ChoiceField": str,
    "TypedChoiceField": str,
    "GenericIPAddressField": str, "IPAddressField": str,
    "FilePathField": str,
    "MultipleChoiceField": list, "TypedMultipleChoiceField": list,
    "JSONField": str,
    "IntegerField": int,
    "FloatField": float,
    "BooleanField": bool, "NullBooleanField": bool,
    "DurationField": int,  # actual type is timedelta; int avoids tz proxy work
}


def _patched_baseform_init(self, *args, **kwargs):
    # Set the framework attributes Form/Field methods read.
    self.is_bound = False
    self.data = {}
    self.files = {}
    self.auto_id = "id_%s"
    self.initial = {}
    self.empty_permitted = False
    self._errors = None
    self._bound_fields_cache = {}
    self.label_suffix = ":"
    self.bound_field_class = getattr(type(self), "bound_field_class", None)
    self.renderer = None
    # base_fields is set on the class by DeclarativeFieldsMetaclass;
    # use it directly (clean_X methods don't typically mutate fields).
    self.fields = getattr(type(self), "base_fields", {})

    space = None
    proxy_for_type = None
    try:
        from crosshair.statespace import context_statespace
        from crosshair.core_and_libs import proxy_for_type as _pft
        space = context_statespace()
        proxy_for_type = _pft
    except BaseException:  # noqa: BLE001
        pass

    cleaned: dict = {}
    cls_name = type(self).__name__
    for fname, fld in self.fields.items():
        py_type = _FORM_FIELD_TO_PY.get(type(fld).__name__, str)
        if space is not None and proxy_for_type is not None:
            try:
                cleaned[fname] = proxy_for_type(py_type, f"{cls_name}_cd_{fname}")
                continue
            except BaseException:  # noqa: BLE001
                pass
        # Concrete fallbacks
        if py_type is str:
            cleaned[fname] = ""
        elif py_type is int:
            cleaned[fname] = 0
        elif py_type is bool:
            cleaned[fname] = False
        elif py_type is float:
            cleaned[fname] = 0.0
        elif py_type is list:
            cleaned[fname] = []
        else:
            cleaned[fname] = None
    self.cleaned_data = cleaned


_BaseForm.__init__ = _patched_baseform_init


# ---------------------------------------------------------------------------
# Layer 3: Manager-side stubs (Model.objects.X())
# ---------------------------------------------------------------------------
#
# Loads _crosshair_stubs.py (generated by Phase 4 of /generate-stubs),
# which monkey-patches Model.objects with a MockManager that returns
# proxy_for_type results with the schema constraint registry applied.
try:
    import _crosshair_stubs  # noqa: F401 — runs install_stubs() on import
except BaseException as _exc:  # noqa: BLE001
    import sys
    print(f"[crosshair_django_setup] _crosshair_stubs not loaded: {_exc!r}",
          file=sys.stderr)


# ---------------------------------------------------------------------------
# Layer 4: Recursive type alias forward-reference resolution
# ---------------------------------------------------------------------------
#
# Projects often define a recursive JSON-like type alias, e.g.:
#     JSONDict = dict[str, "JSONValue"]
#     JSONValue = JSONDict | JSONList | str | int | float | bool | None
# Modules that import only ``JSONDict`` don't have ``JSONValue`` in their
# ``__globals__``, so ``typing.get_type_hints(fn, fn_globals(fn))``
# raises ``NameError`` on the forward ref and CrossHair drops the entire
# signature — leading to "Skipping <fn> because it has no conditions"
# even though the docstring contracts are valid.
#
# Wrap ``typing.get_type_hints`` to merge {{ typealias_module }}'s
# namespace into the resolution globalns.
{% if typealias_module %}
try:
    import sys as _sys_for_hints
    import typing as _typing
    from {{ typealias_module }} import *  # noqa: F401, F403 — pull names into a namespace dict
    _typealias_mod = _sys_for_hints.modules["{{ typealias_module }}"]
    _typealias_globals = vars(_typealias_mod)
    _orig_get_type_hints = _typing.get_type_hints

    # Bind cross-frame references via default args so the closure
    # survives the plugin's exec scope being torn down.
    def _patched_get_type_hints(
        obj, globalns=None, localns=None, include_extras=False,
        _typealias_globals=_typealias_globals,
        _orig_get_type_hints=_orig_get_type_hints,
        _sys=_sys_for_hints,
    ):
        if globalns is None:
            try:
                globalns = (
                    getattr(obj, "__globals__", None)
                    or vars(_sys.modules[getattr(obj, "__module__", "builtins")])
                )
            except (KeyError, AttributeError):
                globalns = {}
        merged = {**_typealias_globals, **globalns}
        return _orig_get_type_hints(
            obj, globalns=merged, localns=localns, include_extras=include_extras
        )

    _typing.get_type_hints = _patched_get_type_hints
    # CrossHair binds get_type_hints at fnutil import time, so we have to
    # rebind it on that module too.
    import crosshair.fnutil as _ch_fnutil
    _ch_fnutil.get_type_hints = _patched_get_type_hints
except BaseException as _exc:  # noqa: BLE001
    import sys
    print(f"[crosshair_django_setup] typealias resolution skipped: {_exc!r}",
          file=sys.stderr)
{% endif %}
